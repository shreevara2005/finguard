# Copy to .env and fill in real values. Never commit the real .env file.
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Optional: defaults to a local SQLite file if unset. Point this at Postgres
# in production, e.g. postgresql://user:password@host:5432/finguard
# DATABASE_URL=sqlite:///./data/finguard.db

# Used by docker-compose to bake the API URL into the frontend build
VITE_API_BASE_URL=http://localhost:8000
